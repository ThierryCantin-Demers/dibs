#!/usr/bin/env bash
# Run a command on a remote machine under a lock, so concurrent agents cannot spoil each other's
# measurements.
#
#   dibs build|test|bench <repo>[@<ref>] <recipe>   run a recipe: dibs list <repo> says
#                                what a repo has, dibs runs what was measured.
#   dibs with <repo>[@<ref>] <service> -- <command>
#                               run the command here while the repo's servers run on the
#                                machine under its lock, ready before it starts and stopped
#                                when it ends. dibs list <repo> says which it defines.
#   dibs list|runs|gaps|shell|raw   the rest of the recipe layer, as in dibs build --help
#   dibs batch <file|->        a list of dibs calls, one per line, run as one submission with
#                                one summary at the end: [name after=a,b cont] before a line
#                                orders it, and a failed step stops the rest unless cont
#   dibs run <command>          shared: builds, tests, inspection. Many at once. The bare
#                                form, dibs <command>, still works.
#   dibs run --bench <command>  exclusive: benchmarks. One at a time, nothing else running.
#   dibs --hold <command>       take the lock on the machine and run the command here, on this
#                                computer: for work aimed at the machine from outside, such as
#                                provisioning it. With --bench nothing else runs there meanwhile.
#                                The lock goes when the command ends, and the command is stopped
#                                if the lock goes first, through --max or --kill.
#   --with <name>='<command>'    run a service on the machine for the length of this call: a
#                                server the command talks to. It starts once the lock is taken
#                                and is stopped before the lock is released, however the call
#                                ends. Repeatable.
#   --port <name>                have the machine pick a free port and reserve it for this call:
#                                the service and the command read it as $DIBS_PORT_<NAME>, and a
#                                --hold command also gets $DIBS_SERVICE_<NAME> as host:port. A
#                                port written into both by hand is one two agents can collide on.
#   --ready tcp:<port|name>      when the --with before it can be used, as a port that answers
#   --ready '<command>'          or a command that exits 0 once it does. --ready-within bounds
#                                the wait (300s). A service that exits early, or is never
#                                ready, stops the call with exit 77 and its log is shown.
#   dibs status, dibs out [job], dibs fetch <job> [dir]   the same as --status, --out, --fetch
#   --device <alias>             run on one named card. Two runs naming one alias are two
#                                runs on the same silicon, which is what makes their numbers
#                                comparable. `dibs --machines -v` lists the aliases. `cpu`
#                                names the processor, which pins nothing and has nothing to
#                                choose between, but records what a CPU run ran on.
#   --stream                     the job's whole output, as it happens. Without it a job's
#                                stdout is a digest: its first and last lines, a count of
#                                what was left out, and where the whole log is. Nothing
#                                is lost either way, since the log is kept on the machine.
#   --new-series                 with --bench: this label is moving to another card of this
#                                machine on purpose. Its series here starts again rather than
#                                mixing the new numbers in with the old ones. Each machine
#                                keeps its own series, so another machine needs no flag.
#   dibs --sync [opts] a b      rsync between here and the machine, under the shared lock.
#                                Prefix the machine's side with a colon: --sync ./tree :~/x
#   dibs --status               who holds it, how much longer, and the queue with ETAs
#   dibs --watch [secs]         --status on a loop, one connection (default 5s, minimum 2)
#   --json                       with --status or --watch: one JSON document per line
#   dibs --peek <command>       look at the machine without taking the lock. Free things
#                                only: ps, nvidia-smi, ls, tail, git status. It runs beside
#                                a benchmark, so anything that costs CPU or IO spoils it.
#   dibs --check [host]          is this machine usable, and what is in it. Run it first on a
#                                machine you have never used. --write records what it found
#                                as that machine's inventory entry.
#   dibs --on <machine>         send this call to a named machine from the inventory. There is
#                                no default: a call that names none is placed when it is shared
#                                work, and refused otherwise, a benchmark most of all
#   dibs --machines             what the inventory knows
#   dibs --forget <machine>     drop a machine from your own inventory
#   dibs --registry-sync        fetch the shared machine list named by DIBS_REGISTRY
#   dibs --update               pull the clone dibs was installed from and reinstall, then
#                                pull the recipe directory too when it is a git clone
#   dibs --detach <command>     run it on the machine named by DIBS_QUEUE, which stays up, so
#                                the job outlives this session closing. Prints a job id. It
#                                moves the caller and takes no lock of its own: to hold one,
#                                detach a dibs call, as in --detach 'dibs --bench <cmd>'.
#                                --on sends the job to a named machine instead of DIBS_QUEUE.
#   dibs --jobs                 what has been submitted there, and how each went
#   dibs --job <id>             one job: its command, its state and its output
#   dibs --cancel <id>          stop a detached job of yours, or someone else's with --anyone.
#                                Takes its whole process group, so the lock it was waiting
#                                for or holding is released with it. A holder that is not a
#                                detached job takes a pid, and --kill, not this.
#   --all                        with --status: every machine in the inventory, at once, which
#                                is also what a status naming no machine shows
#   dibs --pick                 print the machine a shared job naming none would be placed on:
#                                the one holding the repo's build cache, else the least busy.
#                                -v shows the ranking. A benchmark is never placed.
#   dibs --which                print the machine this call names, without placing it
#   dibs --abi [--all]          what decides whether a binary built on one machine runs on
#                                another; --all compares every pair and says which way works
#   --prefer <machine>           with --pick: this machine holds the build cache, so choose it
#                                unless it cannot run the job at all
#   dibs --out [pid|job]        what a job wrote. Every job's output is kept whole on the
#                                machine under $DIBS_SCRATCH/jobs/<job>/log, and the trailer
#                                every job ends with names the job. --out <job> tails it,
#                                during the run or after; --out <pid> reads a redirect a
#                                running job made itself. The first read of a finished job
#                                keeps its whole log in ~/.local/state/dibs/jobs, which
#                                answers later reads even once the machine is gone.
#   dibs --fetch <job> [dir]    the files a recipe's job kept, the ones its `artifacts` name
#                                and it wrote itself. Kept beside the job's log in
#                                ~/.local/state/dibs/jobs/<job>/artifacts, and copied into dir
#                                at their paths when one is given. Takes no lock, so a job's
#                                are capped at 64MB. A recipe run fetches its own.
#   dibs --kill <batch-id>      stop a whole batch: at its driver when that runs here, else on
#                                every machine, which also refuses the batch's later steps
#   dibs --kill <pid>           stop a holder that is wedged (also takes no lock). Refuses a
#                                job that is someone else's until you add --anyone.
#   dibs --release              drop metadata left by processes that are already dead, and
#                                reclaim the lock when an orphan holds it: a process that
#                                outlived its caller holds it with no record to show for it,
#                                and nothing on the machine can run until it goes
#   dibs --gc                   what is filling the machine's scratch, and reclaim it:
#                                worktrees and job logs nobody has used for 14 days, build
#                                caches for 5. It takes the shared lock, since deleting
#                                gigabytes is as much IO as writing them. --dry-run removes
#                                nothing, --days <n> lowers every clock to n days, and what
#                                dibs did not put under scratch is listed but never touched.
#   dibs --friction '<line>'    what got in the way: a flag that is missing, a message that
#                                misled, a bug. One line, kept where the next session reads
#                                it, and printed by dibs gaps beside the recipes nothing
#                                fitted. Nothing else records a problem that is not a
#                                missing recipe.
#   dibs --log [n]              the last n arrivals and outcomes, killings included
#
# A shared job quick enough to be gone before a queued benchmark could have started anyway
# goes around it rather than waiting for the whole benchmark. DIBS_PATIENCE (60s) is how long
# a benchmark tolerates that, DIBS_QUICK (10s) is how quick a job has to be to qualify, and
# DIBS_BYPASS=0 turns it off. A benchmark can be delayed by their sum and no more.
#
#   --on <machine>     send this call there. DIBS_ON=<machine> does the same for every
#                      call, which is the form a step added to a script later cannot forget.
#                      An inventory of one machine, or DIBS_HOST without one, needs neither.
#   --wait <seconds>   give up rather than queue past this
#   --max <seconds>    kill the command if it holds the lock longer than this (default 7200
#                      for --bench and 1800 otherwise, or twice the label's 90th percentile
#                      where its history runs longer, said when it starts)
#   --label <name>     what shows up in --status (default: the caller's directory)
#   -v                 with --status, also dump the raw lock directory; with a call that
#                      queues, the whole queue rather than one line
#
#   exit 69 unreachable    70 no room on the target    71 no lock, nothing ran    75 busy
#        76 its batch was cancelled    77 a --with service failed    124 overran --max
#        78 a recipe's measurement refused: another tree built into its target since
#
# --- end of the interface, everything below is why -------------------------------------
#
# A shared holder blocks a benchmark and a benchmark blocks everything, because a compile
# running beside a benchmark contaminates it as surely as a second benchmark would.
#
# --peek and --kill deliberately ignore the lock. Looking at a wedged machine, and freeing
# it, must not require the thing that is wedged.
#
# That exemption is the whole risk of --peek: it runs while a benchmark holds the machine,
# so the cost of what you peek at is paid by whoever is being measured. Use it only for
# things that are effectively free. Reading a small file, listing a directory, ps,
# nvidia-smi, git status. If it compiles, copies, downloads, greps a tree, or reads
# gigabytes, it is not a peek however read-only it looks: run it as `dibs <command>` and
# take the shared lock, which is what the shared lock is for.
#
# --watch keeps one connection open and redraws from the far side, and a redraw forks
# nothing: it reads the lock files, walks the holder's own process tree through the kernel's
# child lists, and reuses the medians it worked out last time. That is about 2ms against the
# 30ms a --status in a loop spends on a fresh login and a machine-wide process scan.
# It is for a human at a terminal. An agent is told when its own job ends and has nothing
# to watch for.
#
# The lock lives on the machine, not here, so it also covers agents running on it
# itself, and it is held by the workload's own process: it releases when that process
# exits, however it exits, with nothing left to clean up.
#
# A job runs with DIBS_SCRATCH and TMPDIR pointing at ~/.cache/dibs on the target, because
# /tmp there is a shared tmpfs under a quota: one build tree in it stops everyone else from
# running anything at all. Write build output under $DIBS_SCRATCH, never in /tmp.
#
# Exit codes: 69 the machine is unreachable, 70 its scratch directory is full or over quota,
# 75 busy and the wait was bounded, 124 the command overran --max. Anything else is the
# command's own status. DIBS_REMOTE_DIR moves the scratch directory, which is the way back
# in when the default one has filled up.
#
# A job dies with the caller that started it: kill the caller, however you kill it, and the
# work stops and the lock frees. A caller that stops answering, as a laptop does when it sleeps
# or a shell does after Ctrl-Z, counts as gone after DIBS_LEASE seconds (120, and 0 turns it
# off); work that has to outlive that is what --detach is for. DIBS_TRACE=1 traces the remote
# side, and DIBS_NO_PDEATHSIG / DIBS_NO_LIVE / DIBS_NO_WATCHDOG each switch off one half of that
# machinery, which is how it gets debugged when it misbehaves. DIBS_NO_CHILDREN forces the
# fallback way of finding a holder's descendants, which is otherwise unreachable on a kernel
# built the ordinary way.
#
# An unreachable machine fails in seconds with a diagnosis, including whether Tailscale needs a
# login, rather than hanging on a connection or a password prompt. Never retry that in a loop.
#
# Runs on the machine too: it recognizes itself by hostname and takes the lock locally instead
# of trying to ssh to itself.
#
# Every completed run's duration is recorded per label, and --status uses the median of
# those to say how much longer the holder has and when each queued caller should start. It
# says nothing rather than guessing when it has no history to go on.

# Every job records which agent started it, taken from the title of its Claude Code session,
# which is the name the user sees on the window it is running in. --status and --log carry it,
# so a command on the machine leads back to the agent that can be asked about it. A shell that
# is not an agent says so, and a session with no title yet is named by its id.
#
# It calls a holder idle when the CPU under it has not moved between two looks, which catches
# a job that hangs after an hour of work as well as one that never started. That takes two
# looks, and a --watch left running is what supplies them. DIBS_IDLE_AFTER sets how long a
# stretch of nothing has to be, in seconds, before it is worth mentioning.
#
# Never poll this. Launch it with the Bash tool's run_in_background parameter and do other
# work; queueing then costs nothing and the notification arrives when the command is done.

set -uo pipefail

# Everything else is in lib/: beside the clone this runs from, or under libexec where a --copy
# install put it.
_dibs_self=$(readlink -f "$0")
DIBS_LIB=$(dirname "$_dibs_self")/../lib
[ -d "$DIBS_LIB/client" ] || DIBS_LIB=$(dirname "$_dibs_self")/../libexec/dibs/lib
[ -d "$DIBS_LIB/client" ] || {
    echo "dibs: no lib directory beside $_dibs_self or in its libexec. Run install.sh from the clone." >&2
    exit 2
}
for _dibs_part in "$DIBS_LIB"/client/*.sh "$DIBS_LIB"/steps/*.sh; do
    . "$_dibs_part"
done
